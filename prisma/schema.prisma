// prisma/schema.prisma
// TeamManager Pro v3 - Teammanagement & Organisation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// PLAYER - Spielberechtigungsliste (Stammdaten)
// ============================================================================
model Player {
  id               String           @id @default(cuid())
  firstName        String
  lastName         String
  birthYear        Int?             // Geburtsjahrgang, z.B. 2013
  strongFoot       String?          // "R" = Rechtsfuß, "L" = Linksfuß
  performanceGroup String?          // "A" | "B" | "C" | "D"
  nationality      String?          // Staatsangehörigkeit
  parentName       String?
  parentPhone      String?
  parentWhatsapp   String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  attendances      Attendance[]
  nominations      Nomination[]
  borrows          MaterialBorrow[]
  tacticsPresets   TacticsPreset[]
  laundryLog       LaundryLog?
  jerseyIssues     JerseyIssue[]

  @@map("players")
}

// ============================================================================
// EVENT - Training, Spiel, Turnier
// scoreHome / scoreAway: Ergebnis im Format "00:00" (wird im Frontend geparst)
// ============================================================================
model Event {
  id           String      @id @default(cuid())
  title        String
  type         EventType
  date         DateTime
  meetTime     DateTime?
  location     String
  distanceInfo String?
  isAway       Boolean     @default(false)
  notes        String?
  scoreHome    Int?
  scoreAway    Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  attendances  Attendance[]
  nominations  Nomination[]

  @@map("events")
}

enum EventType {
  TRAINING
  MATCH
  TOURNAMENT
}

// ============================================================================
// NOMINATION - Spieler pro Spiel (Feld / Bank / nicht dabei) + Rückennummer
// ============================================================================
model Nomination {
  id           String            @id @default(cuid())
  eventId      String
  playerId     String
  status       NominationStatus
  jerseyNumber Int?
  position     String?           // Position auf dem Taktik-Board, z.B. "ST-1"
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player       Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([eventId, playerId])
  @@index([eventId])
  @@index([playerId])
  @@map("nominations")
}

enum NominationStatus {
  FIELD
  BENCH
  NOT_NOMINATED
}

// ============================================================================
// ATTENDANCE - "x" (PRESENT) / "n" (ABSENT) für Training und Spiel
// ============================================================================
model Attendance {
  id          String            @id @default(cuid())
  eventId     String
  playerId    String
  status      AttendanceStatus
  checkedInAt DateTime?
  updatedAt   DateTime          @updatedAt

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player      Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([eventId, playerId])
  @@index([eventId])
  @@index([playerId])
  @@map("attendances")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

// ============================================================================
// MATERIAL INVENTORY - Bestand (Soll / Ist / Zustand / Lagerort / Prüfung)
// ============================================================================
model MaterialInventory {
  id             String            @id @default(cuid())
  name           String
  category       String
  shouldQuantity Int               @default(0)   // Anzahl Soll
  quantity       Int               @default(0)   // Anzahl Ist
  condition      MaterialCondition @default(GOOD)
  location       String?           // Lagerort
  lastInspection DateTime?         // Letzte Prüfung
  complete       Boolean           @default(true)
  missingItems   String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  borrows        MaterialBorrow[]

  @@map("material_inventory")
}

enum MaterialCondition {
  GOOD
  USED
  DAMAGED
}

// ============================================================================
// MATERIAL BORROW - Übergabe / Rückgabe an Spieler
// ============================================================================
model MaterialBorrow {
  id         String            @id @default(cuid())
  playerId   String
  itemId     String
  borrowedAt DateTime          @default(now())
  returnedAt DateTime?
  status     BorrowStatus
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  player     Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  item       MaterialInventory @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([itemId])
  @@index([status])
  @@map("material_borrows")
}

enum BorrowStatus {
  BORROWED
  RETURNED
  LOST
  DAMAGED
}

// ============================================================================
// JERSEY ISSUE - Trikotwäsche: Trikotsatz pro Spieler ausgegeben
// ============================================================================
model JerseyIssue {
  id         String        @id @default(cuid())
  playerId   String
  jerseySet  String        // z.B. "D2-Heim", "D2-Auswärts"
  issuedAt   DateTime      @default(now())
  returnDue  DateTime?     // Rückgabe Soll
  status     JerseyStatus  @default(PLANNED)
  cleanCheck Boolean       @default(false) // Sauberkeits-Check
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  player     Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@map("jersey_issues")
}

enum JerseyStatus {
  PLANNED       // Geplant
  TAKEN_HOME    // Mitgenommen
  RETURNED      // Abgegeben
}

// ============================================================================
// LAUNDRY LOG - Waschzähler pro Spieler (Fairness-Glocke)
// ============================================================================
model LaundryLog {
  id           String    @id @default(cuid())
  playerId     String    @unique
  count        Int       @default(0)
  lastWashedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  player       Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("laundry_logs")
}

// ============================================================================
// TACTICS PRESET
// ============================================================================
model TacticsPreset {
  id            String      @id @default(cuid())
  name          String
  fieldFormat   FieldFormat
  formation     String
  positionsJson Json
  createdBy     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  player        Player      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("tactics_presets")
}

enum FieldFormat {
  PITCH_11V11
  PITCH_9V9
  PITCH_7V7
  INDOOR_5V5
  INDOOR_4V4
}

// ============================================================================
// USER SETTINGS - Theme
// ============================================================================
model UserSettings {
  id             String      @id @default(cuid())
  colorMode      ColorMode   @default(DARK)
  layoutStyle    LayoutStyle @default(STANDARD)
  primaryColor   String      @default("#2ea043")
  secondaryColor String      @default("#1f6feb")
  bgMain         String      @default("#0d1117")
  bgCard         String      @default("#161b22")
  accentColor    String      @default("#58a6ff")
  compactMode    Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("user_settings")
}

enum ColorMode {
  LIGHT
  DARK
  SYSTEM
}

enum LayoutStyle {
  STANDARD
  MODERN
}
