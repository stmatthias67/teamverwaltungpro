// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Player model - represents a team member
model Player {
  id                String      @id @default(cuid())
  jerseyNumber      Int         @unique
  name              String
  status            PlayerStatus @default(ACTIVE)
  parentPhone       String?
  parentWhatsapp    String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  attendances       Attendance[]
  laundryLog        LaundryLog?
  tacticsPresets    TacticsPreset[]

  @@map("players")
}

enum PlayerStatus {
  ACTIVE
  SICK
  INJURED
}

// Event model - represents training sessions, matches, tournaments
model Event {
  id                String      @id @default(cuid())
  title             String
  type              EventType
  date              DateTime
  meetTime          DateTime?
  location          String
  distanceInfo      String?     // e.g., "8.6 km / 14 Min"
  isAway            Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  attendances       Attendance[]

  @@map("events")
}

enum EventType {
  MATCH
  TRAINING
  TOURNAMENT
}

// Attendance model - tracks presence/absence for events
model Attendance {
  id                String      @id @default(cuid())
  eventId           String
  playerId          String
  status            AttendanceStatus
  updatedAt         DateTime    @updatedAt

  // Relations
  event             Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player            Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // Constraints
  @@unique([eventId, playerId])
  @@index([eventId])
  @@index([playerId])
  @@map("attendances")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

// LaundryLog model - tracks jersey washing count per player
model LaundryLog {
  id                String      @id @default(cuid())
  playerId          String      @unique
  count             Int         @default(0)
  lastWashedAt      DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  player            Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("laundry_logs")
}

// TacticsPreset model - stores formation and field configurations
model TacticsPreset {
  id                String      @id @default(cuid())
  name              String
  fieldFormat       FieldFormat
  formation         String      // e.g., "4-3-3", "4-4-2"
  positionsJson     Json        // Stores player positions on field
  createdBy         String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  player            Player      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("tactics_presets")
}

enum FieldFormat {
  PITCH_11V11
  PITCH_9V9
  PITCH_7V7
  INDOOR_5V5
  INDOOR_4V4
}

// UserSettings model - stores theme and preferences
model UserSettings {
  id                String      @id @default(cuid())
  themePrimary      String      @default("#2ea043")   // Hex color
  themeBgMain       String      @default("#0d1117")
  themeBgCard       String      @default("#161b22")
  themeSecondary    String      @default("#1f6feb")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("user_settings")
}

// MaterialInventory model - tracks team equipment
model MaterialInventory {
  id                String      @id @default(cuid())
  name              String      // e.g., "Trikotsatz Heim (Rot)"
  category          String      // e.g., "Jersey", "Shorts", "Socks"
  quantity          Int
  complete          Boolean     @default(true)
  missingItems      String?     // e.g., "Hose Gr. M"
  lastUpdated       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("material_inventory")
}
